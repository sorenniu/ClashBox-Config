
#!name=腾讯视频广告过滤 V0.2
#!desc=腾讯视频开屏及贴片广告规则；实验版本
#!author=Community-inspired independent test

[Rule]
DOMAIN,ad.tencentvideo.com,REJECT
DOMAIN,adstats.tencentvideo.com,REJECT
DOMAIN,adsmind.gdtimg.com,REJECT
DOMAIN,pgdt.gtimg.cn,REJECT
DOMAIN,adss.video.qq.com,REJECT
DOMAIN,adsmind.apdcdn.tc.qq.com,REJECT
DOMAIN,adsmind.tc.qq.com,REJECT

[Rewrite]
^https?:\/\/vv\.video\.qq\.com\/(diff|get)vmind reject-dict
^https?:\/\/apd-vlive\.apdcdn\.tc\.qq\.com\/vmind\.qqvideo\.tc\.qq\.com\/[A-Za-z0-9._~%/-]+ reject
^https?:\/\/vv\.video\.qq\.com\/getvinfo request-body-replace-regex &sppreviewtype=\d(.*)&spsrt=\d &sppreviewtype=0$1&spsrt=0

[MITM]
hostname = vv.video.qq.com, apd-vlive.apdcdn.tc.qq.com, ad.tencentvideo.com, adstats.tencentvideo.com, adsmind.gdtimg.com, pgdt.gtimg.cn, adss.video.qq.com, adsmind.apdcdn.tc.qq.com, adsmind.tc.qq.com
